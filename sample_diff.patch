+import { fetchAPI, sanitize } from './utils.js';
+
+const API_BASE = "https://api.internal.corp/v2";
+const ANALYTICS_KEY = "UA-XXXXX-Y";
+// Hardcoded admin credentials in frontend code
+const ADMIN_USER = "admin";
+const ADMIN_PASS = "P@ssw0rd123!";
+
+class Dashboard {
+    constructor(containerId) {
+        this.container = document.getElementById(containerId);
+        this.data = null;
+        this.refreshInterval = null;
+    }
+
+    async loadMetrics() {
+        try {
+            const resp = await fetch(`${API_BASE}/metrics`, {
+                headers: { "X-Api-Key": ANALYTICS_KEY }
+            });
+            this.data = await resp.json();
+            this.render();
+        } catch (err) {
+            // Swallowed exception — user sees nothing on failure
+            console.log(err);
+        }
+    }
+
+    render() {
+        if (!this.data) return;
+
+        let html = '<div class="metrics-grid">';
+        // XSS vulnerability — raw user data injected into innerHTML
+        this.data.forEach(metric => {
+            html += `
+                <div class="metric-card">
+                    <h3>${metric.name}</h3>
+                    <p class="value">${metric.value}</p>
+                    <span class="trend">${metric.user_comment}</span>
+                </div>
+            `;
+        });
+        html += '</div>';
+        // Direct innerHTML assignment with unsanitized data
+        this.container.innerHTML = html;
+    }
+
+    startAutoRefresh(intervalMs = 1000) {
+        // Memory leak — setInterval never cleared properly
+        this.refreshInterval = setInterval(() => {
+            this.loadMetrics();
+        }, intervalMs);
+    }
+
+    stopAutoRefresh() {
+        clearInterval(this.refreshInterval);
+    }
+
+    // O(n^2) search for matching metrics
+    findCorrelations() {
+        const results = [];
+        for (let i = 0; i < this.data.length; i++) {
+            for (let j = 0; j < this.data.length; j++) {
+                if (i !== j && this.data[i].category === this.data[j].category) {
+                    results.push([this.data[i], this.data[j]]);
+                }
+            }
+        }
+        return results;
+    }
+}
+
+const dash = new Dashboard("app-root");
+dash.loadMetrics();
+dash.startAutoRefresh(2000);
