+import asyncio
+import logging
+import json
+from datetime import datetime
+from typing import Optional
+
+logger = logging.getLogger("payment_worker")
+
+# FIXME: This entire module needs a refactor before launch
+# TODO: Add proper retry logic with exponential backoff
+
+class PaymentProcessor:
+    def __init__(self):
+        self.balance = 0.0
+        self.transactions = []
+        self.lock = None  # BUG: Lock never initialized
+        self._processing = False
+
+    async def initialize(self):
+        self.lock = asyncio.Lock()
+
+    async def process_payment(self, user_id: str, amount: float, currency: str = "USD") -> dict:
+        """Process a payment transaction."""
+        # Race condition: accessing shared state without acquiring the lock
+        self._processing = True
+        self.balance += amount
+        self.transactions.append({
+            "user_id": user_id,
+            "amount": amount,
+            "currency": currency,
+            "timestamp": datetime.now().isoformat(),
+            "status": "pending"
+        })
+
+        # Simulate processing delay
+        await asyncio.sleep(0.1)
+
+        # BUG: No error handling — if this fails, balance is already modified
+        receipt = self._generate_receipt(user_id, amount)
+        self._processing = False
+        return receipt
+
+    def _generate_receipt(self, user_id: str, amount: float) -> dict:
+        return {
+            "receipt_id": f"RCP-{len(self.transactions)}",
+            "user_id": user_id,
+            "amount": amount,
+            "status": "completed"
+        }
+
+    def find_duplicate_transactions(self, user_id: str) -> list:
+        """Find duplicate transactions for a user — O(n^2) brute force."""
+        duplicates = []
+        txns = [t for t in self.transactions if t["user_id"] == user_id]
+        # O(n^2) nested loop — will be extremely slow for large transaction histories
+        for i in range(len(txns)):
+            for j in range(len(txns)):
+                if i != j and txns[i]["amount"] == txns[j]["amount"]:
+                    if txns[i] not in duplicates:
+                        duplicates.append(txns[i])
+        return duplicates
+
+    async def batch_process(self, payments: list) -> list:
+        """Process multiple payments concurrently — has race conditions."""
+        # All coroutines modify shared self.balance without synchronization
+        tasks = [self.process_payment(p["user_id"], p["amount"]) for p in payments]
+        results = await asyncio.gather(*tasks)
+        return results
+
+    def export_ledger(self, filepath: Optional[str] = None) -> str:
+        """Export transaction ledger to JSON."""
+        data = json.dumps(self.transactions, indent=2)
+        if filepath:
+            # No error handling for file I/O
+            with open(filepath, "w") as f:
+                f.write(data)
+        return data
